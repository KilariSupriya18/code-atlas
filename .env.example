# CodeAtlas Configuration Environment Template

# Generative AI (Official Groq SDK)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Embeddings (Local Sentence Transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_MAX_SEQ_LENGTH=512

# Vector Database (Qdrant)
# Leave QDRANT_URL blank to use embedded persistent Qdrant at QDRANT_PATH
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION_PREFIX=codementor

# Relational Database
# For standalone local run:
DATABASE_URL=sqlite+aiosqlite:///./data/codementor.db
# For Docker Compose:
# DATABASE_URL=postgresql+asyncpg://codementor_user:codementor_secret_password@postgres:5432/codementor

# Cache & Worker Queue
REDIS_URL=redis://localhost:6379/0

# Storage & Ingestion Limits
REPO_STORAGE_PATH=./data/repos
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_KB=500
GIT_CLONE_TIMEOUT_SECONDS=60

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:5173
